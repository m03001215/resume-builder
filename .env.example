## Copy this file to `.env.local` for local dev.
## Do NOT commit `.env.local` (it contains secrets / project keys).

# Supabase (required)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# OpenAI: the key is NOT a Vite variable and never reaches the browser. It lives in the
# openai-proxy edge function as a Supabase secret:
#   supabase secrets set OPENAI_API_KEY=sk-... OPENAI_MODEL=gpt-4o-mini
#   supabase functions deploy openai-proxy

